#!/usr/bin/env bash
# Pre-push gate for the Lite product (refactor Phase 1b). Fast, local checks
# chosen by what the branch changed; CI (.github/workflows/ci.yml) runs the
# full set on every PR. Do not bypass it with --no-verify: fix what it reports.

# Self-identity tripwire: this hook must be the copy checked out in the tree
# being pushed. A foreign core.hooksPath silently runs another checkout's hook
# (docs/engineering/solutions/performance-issues/git-push-timeout-stale-core-hookspath.md).
# Escape hatch for an intentional central-hook setup: WM_ALLOW_FOREIGN_HOOKS=1.
if [ -z "${WM_ALLOW_FOREIGN_HOOKS:-}" ] && [ -n "${BASH_SOURCE[0]:-}" ]; then
  _hook_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)
  _wt_root=$(cd "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null && pwd -P)
  if [ -n "$_hook_dir" ] && [ -n "$_wt_root" ] && [ "$_hook_dir" != "$_wt_root/.husky" ]; then
    if node "$_wt_root/scripts/bootstrap-worktree.mjs" --hooks-only --root "$_wt_root"; then
      if [ "$(git config --get core.hooksPath 2>/dev/null || true)" = ".husky" ]; then
        echo "[worktree] hooksPath repaired; continuing with $_wt_root/.husky/pre-push"
        exec bash "$_wt_root/.husky/pre-push" "$@"
      fi
    fi
    echo "ERROR: pre-push hook is executing from outside this worktree ($_hook_dir)."
    echo "Run: git config core.hooksPath .husky (or set WM_ALLOW_FOREIGN_HOOKS=1)."
    exit 1
  fi
fi

set -u

# Git-env hygiene and identity gate. During a push git exports GIT_DIR,
# GIT_WORK_TREE and GIT_INDEX_FILE to this hook; they override cwd for every
# child, so a test fixture that runs `git config user.name` writes its fake
# identity into the shared .git/config (2026-08-30 "Fixture" incident). Capture
# the push stdin for the gate, then strip the variables git publishes.
WM_PUSH_STDIN=$(cat || true)
printf '%s\n' "$WM_PUSH_STDIN" | bash scripts/prepush-identity-gate.sh || exit 1
for _git_env in $(git rev-parse --local-env-vars 2>/dev/null); do
  unset "$_git_env" 2>/dev/null || true
done
unset _git_env

cd "$(git rev-parse --show-toplevel)" || exit 1

node scripts/check-local-secret-dumps.mjs --pre-push "${1:-}" || exit 1

# Changed paths since the branch left its base. The refactor integration branch
# is the base while it exists, then main. If neither resolves, check everything.
CHANGED=""
for base in origin/refactor/lite-monorepo origin/main; do
  if git rev-parse --verify --quiet "$base" >/dev/null; then
    CHANGED=$(git diff --name-only "$(git merge-base HEAD "$base")" HEAD 2>/dev/null) && break
  fi
done
RUN_ALL=false
[ -z "$CHANGED" ] && RUN_ALL=true

changed() {
  [ "$RUN_ALL" = true ] && return 0
  printf '%s\n' "$CHANGED" | grep -Eq "$1"
}

run() {
  echo "pre-push: $*"
  "$@" || { echo "pre-push: FAILED: $*"; exit 1; }
}

if changed '^(apps/web/|packages/client/|packages/shared/|packages/server/|packages/contracts/generated/|tests/|tsconfig|package\.json$|packages/(contracts|shared)/package\.json$)'; then
  run npm run --silent typecheck
fi
if changed '^(api/|packages/server/|packages/shared/|packages/client/|packages/contracts/generated/|middleware\.ts$|tsconfig|package\.json$)'; then
  run npm run --silent typecheck:api
fi
if changed '^(api/|packages/server/|packages/shared/|packages/client/|packages/contracts/generated/|scripts/check-edge-function-bundles\.mjs$)'; then
  run node scripts/check-edge-function-bundles.mjs --caller=prepush
fi
if changed '^(apps/web/|packages/client/|packages/shared/)'; then
  run npm run --silent lint:boundaries
  run npm run --silent lint:safe-local-storage
fi
if changed '\.(md|mdx)$'; then
  run npm run --silent lint:md
fi
if changed '^(\.github/workflows/|ARCHITECTURE\.md$|scripts/docs-stats\.mjs$|\.husky/pre-push$)'; then
  run npm run --silent docs:check
fi
if changed '^(packages/contracts/proto/|Makefile$)'; then
  if command -v buf >/dev/null 2>&1; then
    run make generate
    if ! git diff --quiet -- packages/contracts/generated packages/contracts/openapi; then
      echo "pre-push: FAILED: make generate changed packages/contracts/generated or packages/contracts/openapi; commit the result."
      exit 1
    fi
  else
    echo "pre-push: proto changed but buf is not installed; CI (proto-check.yml) will verify generation."
  fi
fi

echo "pre-push: OK"
