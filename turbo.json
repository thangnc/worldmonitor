{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "globalDependencies": [".nvmrc", "tsconfig.base.json"],
  "tasks": {
    "//#typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/engineering/**", "!tests/**"],
      "outputs": []
    },
    "//#typecheck:api": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/engineering/**", "!tests/**"],
      "outputs": []
    },
    "//#typecheck:contract-tests": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/engineering/**"],
      "outputs": []
    },
    "//#typecheck:dom-tests": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/engineering/**"],
      "outputs": []
    },
    "//#build": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/engineering/**", "!tests/**", ".env*"],
      "env": ["VITE_*", "VERCEL_GIT_COMMIT_SHA"],
      "outputs": ["dist/**"]
    }
  }
}
