{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "globalDependencies": [".nvmrc", "tsconfig.base.json"],
  "tasks": {
    "//#typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/engineering/**", "!tests/**"],
      "outputs": []
    },
    "//#typecheck:api": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/engineering/**", "!tests/**"],
      "outputs": []
    },
    "//#typecheck:contract-tests": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/engineering/**"],
      "outputs": []
    },
    "//#typecheck:dom-tests": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/engineering/**"],
      "outputs": []
    },
    "@wm/web#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "$TURBO_ROOT$/.env*",
        "!$TURBO_ROOT$/dist/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/.claude/worktrees/**",
        "!$TURBO_ROOT$/.claude/verify-evidence/**",
        "!$TURBO_ROOT$/**/target/**",
        "!$TURBO_ROOT$/blog-site/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/docs/engineering/**",
        "!$TURBO_ROOT$/tests/**"
      ],
      "env": ["VITE_*", "VERCEL_GIT_COMMIT_SHA"],
      "outputs": ["$TURBO_ROOT$/dist/**"]
    }
  }
}
